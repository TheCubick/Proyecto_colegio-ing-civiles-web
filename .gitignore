# Archivos windows
Desktop.ini

# Notas internas del Consejo (solo locales)
Notas_observaciones.txt

# Archivos temporales de Office
~$*

# Variables de entorno y credenciales (Supabase, etc.): NUNCA en git.
# La plantilla sin valores (.env.example) sí se sube.
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json
service-account*.json
supabase/.temp/

# Config MCP local (puede traer claves de API vía variables de entorno)
.mcp.json

# Editor (cada quien los suyos; visuales/.gitignore ya hace lo mismo para esa carpeta)
.vscode/

# Carpetas temporales de herramientas de auditoría (Playwright, capturas de depuración)
.playwright-mcp/
*.playwright-mcp/

# Documentación y bitácora interna del equipo: se queda en cada máquina, no se sube
# (planes, auditorías, SQL de referencia y el contexto/instrucciones de Claude Code).
docs/
CLAUDE.md
